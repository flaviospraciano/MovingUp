{
  "id": "./",
  "name": "Moving Up",
  "short_name": "Moving Up",
  "description": "Organização pessoal para elevar sua performance: treinos, hábitos, metas, gastos, lembretes e muito mais.",
  "lang": "pt-BR",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F5F5F9",
  "theme_color": "#16142E",
  "categories": [
    "productivity",
    "lifestyle",
    "health"
  ],
  "icons": [
    {
      "src": "mu-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "mu-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "mu-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Câmera rápida",
      "short_name": "Câmera",
      "description": "Tirar foto e mandar para a atividade",
      "url": "./index.html?acao=camera",
      "icons": [
        {
          "src": "icons/atalho-camera.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Novo gasto",
      "short_name": "Gasto",
      "description": "Lançar um gasto",
      "url": "./index.html?acao=gasto",
      "icons": [
        {
          "src": "icons/atalho-gasto.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nova tarefa",
      "short_name": "Tarefa",
      "description": "Anotar uma tarefa",
      "url": "./index.html?acao=tarefa",
      "icons": [
        {
          "src": "icons/atalho-tarefa.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Falar com o Jarvis",
      "short_name": "Jarvis",
      "description": "Abrir o Jarvis ouvindo",
      "url": "./index.html?acao=jarvis",
      "icons": [
        {
          "src": "icons/atalho-jarvis.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Beber água",
      "short_name": "Água",
      "description": "Somar um copo de água",
      "url": "./index.html?acao=agua",
      "icons": [
        {
          "src": "icons/atalho-agua.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "arquivos",
          "accept": [
            "image/*",
            ".gpx",
            ".tcx",
            ".fit",
            ".zip",
            ".gz",
            "application/gpx+xml",
            "application/vnd.garmin.tcx+xml",
            "application/xml",
            "text/xml",
            "application/octet-stream",
            "application/zip",
            "application/gzip"
          ]
        }
      ]
    }
  }
}

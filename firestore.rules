rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa só lê e grava os próprios dados (inclui os tokens dos aparelhos para os avisos).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Fila de avisos: cada item leva o uid do dono e o id começa com esse uid.
    // Quem envia é o GitHub Actions (automacao/enviar-avisos.mjs), com a conta de serviço do Firebase.
    match /pushq/{id} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && id.matches(request.auth.uid + '_.*');
    }
  }
}
